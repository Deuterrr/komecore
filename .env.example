# ==============================================================================
# komecore — Environment Configuration Template
# ==============================================================================

# --- Application Server ---
APP_NAME=komecore
APP_HOST=127.0.0.1
APP_PORT=7129
APP_ENV=development
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4000,http://127.0.0.1:3000
SERVER_TIMEOUT=30
SHUTDOWN_TIMEOUT=15
# Automatically apply database migrations on application startup
AUTO_MIGRATE=true

# --- Database Selection ---
# Options: postgres | supabase (cloud) | sqlserver
DB_TARGET=postgres

# --- PostgreSQL Database ---
POSTGRES_DB_NAME=komecore_db
POSTGRES_DB_USER=postgres
POSTGRES_DB_PASSWORD=postgres
POSTGRES_DB_HOST=127.0.0.1
POSTGRES_DB_PORT=5432
POSTGRES_DB_SSLMODE=disable

# --- Supabase (Optional Storage & Remote DB) ---
SUPABASE_PROJECT_URL=
SUPABASE_SUPA_KEY=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_SSLMODE=disable
STORAGE_SIGNED_URL_EXPIRY=3600

# --- Media & Object Storage Provider ---
# Options: supabase | gcs | noop (defaults to supabase or auto-detect)
STORAGE_PROVIDER=supabase

# --- Google Cloud Storage (when STORAGE_PROVIDER=gcs) ---
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_CREDENTIALS_FILE=
GCS_CREDENTIALS_JSON=

# --- SQL Server Database (optional) ---
SQLSERVER_DB_HOST=
SQLSERVER_DB_PORT=1433
SQLSERVER_DB_NAME=
SQLSERVER_DB_USER=
SQLSERVER_DB_PASSWORD=

# --- Authentication ---
JWT_SECRET=your_super_secret_jwt_key_change_me_in_production

# --- Logistics & Courier ---
LOGISTICS_PROVIDER=manual

# --- Payment Synchronization & Expiration Jobs ---
PAYMENT_SYNC_INTERVAL_MINUTES=5
PAYMENT_SYNC_LOOKBACK_HOURS=24
PAYMENT_EXPIRY_INTERVAL_MINUTES=1
PAYMENT_EXPIRY_BATCH_SIZE=100
PAYMENT_EXPIRY_CONCURRENCY=5

# --- Midtrans Payment Gateway ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_URL=https://api.sandbox.midtrans.com
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# --- SMTP Mailer ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@komecore.store

# --- Google OAuth ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:7129/auth/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:3000/auth/callback
