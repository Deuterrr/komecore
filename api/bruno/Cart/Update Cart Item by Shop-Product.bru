meta {
  name: Update Cart Item by Shop/Product
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/v1/carts/items/{{shopId}}/{{productId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "quantity": 4,
    "item_options": {
      "variant": "5kg"
    }
  }
}
