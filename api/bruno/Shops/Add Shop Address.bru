meta {
  name: Add Shop Address
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/shops/{{shopId}}/addresses
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

