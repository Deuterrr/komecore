meta {
  name: Update Shop Address
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/api/v1/shops/{{shopId}}/addresses/{{addressId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{staffToken}}
}

body:json {
  {
    "label": "West Hub Warehouse - Updated",
    "phone": "+628123456789",
    "is_active": "true",
    "province": "DKI Jakarta",
    "province_id": "31",
    "city": "Jakarta Barat",
    "city_id": "3173",
    "district": "Kebon Jeruk",
    "district_id": "317305",
    "village_id": "3173051001",
    "full_address": "Jl. Panjang No. 8B, Kebon Jeruk",
    "postal_code": "11530"
  }
}
