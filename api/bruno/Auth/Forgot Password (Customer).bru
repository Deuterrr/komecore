meta {
  name: Forgot Password (Customer)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "customer@komecore.com"
  }
}

example {
  name: v1.1.0-pre
  
  request: {
    url: {{baseUrl}}/api/v1/auth/forgot-password
    method: POST
    mode: json
    body:json: {
      {
        "email": "customer@komecore.com"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json
