meta {
  name: Create Product Review
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products/{{productId}}/reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{customerToken}}
}

body:json {
  {
    "rating": 5,
    "title": "Excellent quality",
    "comment": "The rice is fragrant and fresh. Highly recommended!"
  }
}
